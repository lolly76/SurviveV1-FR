# Configuration SurviveV1-FR
# Modifiez ce fichier pour adapter votre installation
# Généré par : bash setup/first_run.sh (ou install/wizard.sh)

# ── Stockage ────────────────────────────────────────────────────────────────────
SURVIVE_STORAGE_PATH="/mnt/survive"
SURVIVE_STORAGE_DEV="SKIP"
# dedie = disque dédié monté (SSD USB, 2e disque) ; dossier = dossier sur le disque
# du système (ex. /srv/survive), sans formatage. Voir aussi config/profiles/ et
# « bash scripts/apply_profile.sh <leger|moyen|complet> » pour changer de profil.
SURVIVE_STORAGE_MODE="dedie"
SURVIVE_BUDGET_GB="800"
SURVIVE_HOSTNAME="survive"

# ── Contenus (Y/O = télécharger, N = ignorer) ────────────────────────────────────────
CONTENT_WIKIPEDIA="Y"
CONTENT_WIKIPEDIA_NOPIC="N"
CONTENT_WIKIBOOKS="Y"
CONTENT_STACKEXCHANGE="Y"
# Sites Stack Exchange pratiques en ANGLAIS (~40 Go) : aucun équivalent français
CONTENT_STACKEXCHANGE_EN="N"
CONTENT_GUTENBERG="Y"
# Khan Academy FR en ZIM Kiwix (~94 Go), distinct de Kolibri (~200 Go)
CONTENT_KHAN_ZIM="Y"
CONTENT_KOLIBRI="Y"
CONTENT_VIDEOS="Y"
CONTENT_MAPS="Y"
CONTENT_PDFS="Y"
CONTENT_AI_MODELS="Y"
CONTENT_IFIX="Y"
# Extras FR sélectionnés (~4 Go) : Ekopédia, Cuisine Libre, simulations PhET,
# Wikiversité, Vikidia
CONTENT_EXPANSION="Y"
# Extras EN (~3 Go), sans équivalent français : collections Kiwix catastrophes/
# secours/eau/alimentation/nœuds, Appropedia, Energypedia
CONTENT_EXPANSION_EN="N"
# Pack « English » des contenus experts (médecine avancée, obstétrique, dentaire,
# assainissement, élevage, semences, forge, apiculture, sécurité…) : ressources
# sans équivalent français vérifié, conservées en anglais. N pour les ignorer.
CONTENT_GAPS_EN="Y"
# Autres packs « English » (désactivés par défaut) : manuels militaires américains,
# PDF d'agriculture/ingénierie/radio (CONTENT_PDFS_EN), chaînes YouTube
# anglophones (CONTENT_VIDEOS_EN), PDF et vidéos de santé mentale en anglais
# (CONTENT_MENTAL_EN). Mettre Y pour les télécharger.
CONTENT_PDFS_EN="N"
CONTENT_VIDEOS_EN="N"
CONTENT_MENTAL_EN="N"
# Dépôt d'applications hors ligne (~1 Go) : Kiwix Android/Desktop, F-Droid, VLC,
# pour que les invités du point d'accès Wi-Fi installent les lecteurs sans Internet.
CONTENT_APPS="Y"
# Référence des médicaments hors ligne (quelques centaines de Mo) : Base de
# données publique des médicaments (BDPM), recherche par nom, substance ou
# symptôme, avec une recherche d'interactions dans le texte des notices.
CONTENT_DRUGS="Y"
# Récupération lente et reprenable des notices officielles (indications,
# posologie, contre-indications...). N = noms, compositions et conditions de
# prescription seulement. SURVIVE_DRUGS_NOTICE_MAX limite les pages par passage.
CONTENT_DRUG_NOTICES="Y"
# Client web Meshtastic (~10 Mo) servi sur :8084 pour les radios maillées LoRa.
CONTENT_MESHTASTIC="Y"
# Client web MeshCore (~50 Mo) sur :8085, plus ses applications Android/Windows
# (~130 Mo) pour le dépôt d'applications.
CONTENT_MESHCORE="Y"
# Cartes PDF officielles des parcs nationaux AMÉRICAINS (~2-3 Go ; régions
# nord-américaines uniquement, sans objet pour la France).
CONTENT_NPS_MAPS="N"
# Calque satellite mondial pour la page Cartes, zoom 0-6 (~25 Mo).
CONTENT_SATELLITE="Y"

# ── Qualité vidéo (480, 720, 1080) ─────────────────────────────────────────────
VIDEO_QUALITY="720"

# ── Modèle d'IA préféré ────────────────────────────────────────────────────────
SURVIVE_AI_MODEL="survive"

# Pointer le tableau de bord vers un serveur Ollama DISTANT plutôt que le local :
# un mini-PC x86 plus puissant fait l'inférence tandis que le Pi reste le nœud
# toujours allumé. Laisser vide pour utiliser l'Ollama du Pi. Sur la machine
# satellite, lancer Ollama avec OLLAMA_HOST=0.0.0.0 pour accepter le réseau local.
#   p. ex. SURVIVE_OLLAMA_HOST="http://192.168.1.50:11434"
# Satellites économiques (le Pi reste principal, satellite allumé au besoin) :
#   mini-PC d'occasion Dell OptiPlex/HP EliteDesk micro (32 Go) -> 7-9B à 5-8 tok/s
#   Minisforum Ryzen 7840HS/8945HS + 780M                       -> 8B à 12-17 tok/s
SURVIVE_OLLAMA_HOST=""

# Stockage des compteurs de limitation de débit. Par défaut (vide => memory://),
# le comptage se fait par processus gunicorn : avec 2 processus, les limites
# réelles sont ~2 fois plus hautes. Pour des limites exactes, installez redis
# (apt install redis-server ; pip install 'limits[redis]') puis définissez :
#   SURVIVE_LIMITER_STORAGE="redis://127.0.0.1:6379"
SURVIVE_LIMITER_STORAGE=""

# ── Synchronisation cloud ─────────────────────────────────────────────────────────────────
# Nom du stockage distant configuré dans rclone (lancer : bash sync/setup_rclone.sh)
SURVIVE_CLOUD_REMOTE="gdrive"
SURVIVE_CLOUD_PATH="SurviveV1"

# ── Région des cartes ─────────────────────────────────────────────────────────────────
# Choix : france, europe, north-america, south-america, africa, asia, world
MAP_REGION="france"

# ── Point d'accès Wi-Fi hors réseau ────────────────────────────────────────────────────
# Utilisé par scripts/hotspot.sh — le Pi diffuse son propre réseau pour que les
# appareils accèdent à la base sans routeur. Mot de passe : 8 à 63 caractères.
SURVIVE_HOTSPOT_SSID="SurviveV1"
SURVIVE_HOTSPOT_PASS="survive2026"

# ── Modules matériels (voir : bash scripts/detect_hardware.sh --table) ────────
# auto = activé seulement si le matériel le permet ; on = forcé ; off = désactivé.
#   AI       IA locale (Ollama) — désactivée sans AVX2 ou sous 4 Go de RAM
#   HAILO    AI Hat Hailo (Raspberry Pi seulement)
#   PI_USB   courant USB / TRIM du Pi 5
#   HOTSPOT  point d'accès Wi-Fi hors réseau (carte Wi-Fi compatible AP requise)
#   LID      portable : la fermeture du capot ne met pas en veille
#   BATTERY  portable : surveillance de la batterie (onduleur de secours)
SURVIVE_MODULE_AI="auto"
SURVIVE_MODULE_HAILO="auto"
SURVIVE_MODULE_PI_USB="auto"
SURVIVE_MODULE_HOTSPOT="auto"
SURVIVE_MODULE_LID="auto"
SURVIVE_MODULE_BATTERY="auto"

# ── Ignorer la configuration de l'AI Hat ──────────────────────────────────────────────────────────
# Mettre à true si vous n'avez pas l'AI Hat Hailo
SKIP_AI_HAT="false"

# ── Mise à jour automatique nocturne des contenus ──────────────────────────────────────────
# Si true, systemd lance scripts/update_content.sh --scheduled chaque nuit à
# SURVIVE_AUTO_UPDATE_TIME (heure locale, HH:MM). Il ne comble que les manques
# (nouvelles vidéos, livres, ZIM manquants, client Meshtastic, modèles) et ne
# fait rien si le Pi est hors ligne. La page État a un interrupteur pour ce même
# minuteur. Relancez `sudo bash scripts/generate_services.sh` après avoir changé
# l'heure ou le plafond. Plafond en octets/s (2097152 = 2 Mo/s) ; 0 = illimité.
SURVIVE_AUTO_UPDATE="false"
SURVIVE_AUTO_UPDATE_TIME="02:30"
SURVIVE_AUTO_UPDATE_RATE_LIMIT="2097152"

# ── Limitation de débit ─────────────────────────────────────────────────────────
# Limite la vitesse de téléchargement pour ne pas saturer votre connexion
# Format : entier en octets/s, ou 0 pour illimité
# Exemples : 5242880 = 5 Mo/s, 10485760 = 10 Mo/s, 0 = illimité
SURVIVE_BANDWIDTH_LIMIT="0"

# ── Délais d'attente du serveur web (secondes) ──────────────────────────────────────────────
# Augmentez-les si les services répondent lentement sur votre matériel
SURVIVE_SERVICE_CHECK_TIMEOUT="1"   # test d'accessibilité des ports
SURVIVE_OLLAMA_LIST_TIMEOUT="2"     # récupération de la liste des modèles Ollama
# Le chat IA envoie la réponse au fil de l'eau : c'est donc un délai d'INACTIVITÉ
# entre deux morceaux, pas un plafond de durée. Il doit couvrir le CHARGEMENT À
# FROID du modèle (7,6 Go depuis l'USB pour gemma4:12b : 30-80 s sur un Pi 5),
# d'où 300.
# NOTE : le tableau de bord tourne sous systemd et NE lit PAS ce fichier ; cette
# valeur n'affecte que les lancements manuels. Le défaut systemd est dans server.py.
SURVIVE_AI_CHAT_TIMEOUT="300"

# ── Téléchargements YouTube ──────────────────────────────────────────────────────────
# YouTube bloque beaucoup de téléchargements automatiques (« Connectez-vous pour
# confirmer que vous n'êtes pas un robot »). Renseignez UNE de ces options :
#   SURVIVE_YTDLP_COOKIES  chemin d'un cookies.txt exporté d'un navigateur connecté
#   SURVIVE_YTDLP_BROWSER  lire les cookies d'un navigateur local (p. ex. chromium)
# Laissez les deux vides pour tenter des téléchargements anonymes (les vidéos
# bloquées sont ignorées).
SURVIVE_YTDLP_COOKIES=""
SURVIVE_YTDLP_BROWSER=""
